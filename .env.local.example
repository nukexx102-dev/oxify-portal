# Copy this file to .env.local and fill in real values yourself, in your
# editor. Never paste the token into a chat. On Vercel, set these same
# variables under Project Settings > Environment Variables.

# ClickUp personal API token (ClickUp > Settings > Apps) with read access
# to the Oxify space.
CLICKUP_API_TOKEN=

# Oxify space > "OXFY ORDER STATUS CRM"
CLICKUP_ORDERS_LIST_ID=1300420000052877

# Optional. Leave empty to use the built-in copy in src/lib/portalContent.ts.
# Set it to an Oxify-only "Portal Status Copy" list to let staff edit the
# wording in ClickUp. Never point this at Morelli's list.
CLICKUP_STATUS_COPY_LIST_ID=

# Optional. The chamber photo library: a Google Sheet with columns
# Chamber Model | Chamber Color | Photo (Google Drive link), shared as
# "Anyone with the link can view". Paste its normal share link. Orders
# without their own HBOT Photo link get the photo for their model + color.
CHAMBER_PHOTOS_SHEET_URL=
